        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ { error: 'Quota exceeded. You have used all ' + $json.limit + ' AI calls this month. Upgrade to Pro for more.', tier: $json.tier, limit: $json.limit, call_count: $json.call_count } }}",
                "options": {}
            },
