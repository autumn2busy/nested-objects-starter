        {
            "parameters": {
                "method": "POST",
                "url": "https://api.groq.com/openai/v1/chat/completions",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "groqApi",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"model\": \"llama3-70b-8192\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an AI concierge for Nested Objects, a platform serving Gig Economy field service workers (Mortgage Field Inspectors, Property Preservation Specialists, Notaries). \\n\\nCRITICAL: You are NOT speaking to licensed Home Inspectors (real estate transaction inspections). Do NOT recommend certifications/tools specific to Home Inspectors (e.g. ASHI, InterNACHI) unless explicitly asked. \\n\\nHelp members with: career guidance, finding firms, training, industry requirements (background checks, ABC#), and business growth. Be direct, practical, encouraging, and specific. Keep responses concise and actionable.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $json.prompt }}\"\n    }\n  ],\n  \"temperature\": 0.7,\n  \"max_tokens\": 1000\n}",
                "options": {}
            },
            "id": "8dc7aa11-aa04-4045-8b91-e22230287bc1",
            "name": "Call Groq AI",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                880,
                368
            ],
            "credentials": {
                "groqApi": {
                    "id": "qFg32H9JPGlwitUF",
                    "name": "Groq API"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "// Extract response from Groq\nconst groqResponse = $input.first().json;\n\n// Get user/quota data from the \"Has Quota?\" node (carries forward all the data)\nconst quotaData = $('Has Quota?').first().json;\n\nreturn [{\n  json: {\n    // Data for logging\n    user_id: quotaData.user_id,\n    outseta_uid: quotaData.outseta_uid,\n    tier: quotaData.tier,\n    prompt_tokens: groqResponse.usage?.prompt_tokens || 0,\n    completion_tokens: groqResponse.usage?.completion_tokens || 0,\n    total_tokens: groqResponse.usage?.total_tokens || 0,\n    model: groqResponse.model || 'llama3-70b-8192',\n    // Response to return\n    response: groqResponse.choices[0]?.message?.content || 'No response',\n    remaining: quotaData.remaining - 1\n  }\n}];\n"
            },
