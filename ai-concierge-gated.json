        {
            "parameters": {
                "jsCode": "// Extract and decode JWT\nconst body = $input.item.json.body;\n\nif (!body.jwt || !body.prompt) {\n  return [{ json: { error: 'Missing jwt or prompt', valid: false } }];\n}\n\ntry {\n  // Decode Outseta JWT (base64 decode middle part)\n  const jwt = body.jwt;\n  const parts = jwt.split('.');\n  const payload = JSON.parse(Buffer.from(parts[1], 'base64').toString());\n  \n  // Extract tier from Outseta JWT structure\n  let tier = 'free';\n  if (payload.Account?.SubscriptionPlan?.Uid) {\n    const planUid = payload.Account.SubscriptionPlan.Uid.toLowerCase();\n    if (planUid.includes('agency')) tier = 'agency';\n    else if (planUid.includes('elite')) tier = 'elite';\n    else if (planUid.includes('pro')) tier = 'pro';\n  }\n  \n  return [{ \n    json: {\n      valid: true,\n      user_id: payload.uid,\n      outseta_uid: payload.uid,\n      tier: tier,\n      prompt: body.prompt\n    }\n  }];\n} catch (error) {\n  return [{ json: { error: 'Invalid JWT', valid: false } }];\n}\n"
            },
            "id": "235bf61b-0e78-4cb9-9ae9-448f7cc1dc05",
            "name": "Validate & Decode JWT",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                -448,
                160
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{ $json.valid }}",
                            "value2": true
                        }
                    ]
                }
            },
            "id": "2f6f40ea-2fa4-4c0f-9adc-9f1a74cc9f82",
            "name": "Is Valid?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                -224,
                160
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ { error: $json.error || 'Invalid request' } }}",
                "options": {}
            },
            "id": "f820b47c-40ae-44b6-80a4-856d01416eee",
            "name": "Return Error - Invalid",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "jsCode": "// Tier limits\nconst limits = {\n  free: 5,\n  pro: 50,\n  elite: 200,\n  agency: 999999\n};\n\n// Get usage data from HTTP Request response\nconst usageResponse = $input.first().json;\n\n// Handle both fullResponse format and direct format\nconst callCount = parseInt(usageResponse.call_count || usageResponse.body?.call_count) || 0;\n\n// Get user data from earlier node\nconst userData = $('Validate & Decode JWT').first().json;\nconst tier = userData.tier;\n\nconst limit = limits[tier] || 0;\nconst allowed = callCount < limit;\n\nreturn [{\n  json: {\n    user_id: userData.user_id,\n    outseta_uid: userData.outseta_uid,\n    tier: tier,\n    prompt: userData.prompt,\n    call_count: callCount,\n    limit: limit,\n    remaining: Math.max(0, limit - callCount),\n    allowed: allowed\n  }\n}];"
            },
            "id": "faebefd9-8d64-4661-8b69-102f1a9b012e",
            "name": "Calculate Quota",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                432,
                272
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{ $json.allowed }}",
                            "value2": true
                        }
                    ]
                }
            },
            "id": "3126aab3-5a6a-46d6-8e11-eda15a3b32c1",
            "name": "Has Quota?",
