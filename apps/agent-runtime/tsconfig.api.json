{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "src/**/*.ts",
    "api/**/*.ts",
    "server/**/*.ts",
    "workflows/**/*.ts",
    "nitro.config.ts",
    "vitest.workflow.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
