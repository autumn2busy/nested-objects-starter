{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts --no-audit --no-fund",
  "buildCommand": "npm run build:runtime",
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/operations/free-journey-refresh.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/operations/free-journey-refresh",
      "schedule": "0 * * * *"
    }
  ]
}
