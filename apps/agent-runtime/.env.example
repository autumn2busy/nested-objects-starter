# Phase C2 is preview-only, dry-run-only, and synthetic-data-only.
AGENT_RUNTIME_ENV=preview
AGENT_RUNTIME_MODE=dry_run
AGENT_MUTATIONS_ENABLED=false
AGENT_MODEL_EXECUTION_ENABLED=false
AGENT_WORKFLOW_PROVIDER=in_memory
AGENT_RUNTIME_VERSION=phase-c2-v1
AGENT_TRACE_NAMESPACE=nested-objects-intelligence-os

# Required for the authenticated preview evaluation endpoint.
# Generate a random value with at least 32 characters and store it only in Vercel Preview/Development settings.
AGENT_PREVIEW_API_TOKEN=
AGENT_PREVIEW_SYNTHETIC_ONLY=true

# Phase C2 has no database write capability. This must remain false.
# Do not configure SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, or AGENT_STAGING_PROJECT_REF.
AGENT_PREVIEW_PERSISTENCE_ENABLED=false

# Model execution remains disabled in Phase C2.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=
OPENAI_AGENT_MAX_TURNS=4

# Optional Vercel identifiers. VERCEL_ENV is supplied by Vercel and must not be set manually.
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_TOKEN=

# Phase C3 durable staging profile (do not uncomment until the nonsecret staging
# project reference is reviewed in src/runtime/staging-destination.ts and its
# database sentinel is installed through the approved staging migration path).
# Keep these variables in Vercel Preview/Development only. Never copy a
# Production Supabase URL or key into this project.
# AGENT_WORKFLOW_PROVIDER=vercel_workflow
# AGENT_RUNTIME_VERSION=phase-c3-v1
# AGENT_DURABLE_PERSISTENCE_ENABLED=true
# AGENT_DURABLE_SYNTHETIC_ONLY=true
# AGENT_STAGING_WORKFLOW_TOKEN=
# AGENT_STAGING_PROJECT_REF=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
