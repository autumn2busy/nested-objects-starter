# Runtime safety. Phase B supports dry-run analysis and internal persistence only.
AGENT_RUNTIME_ENV=development
AGENT_RUNTIME_MODE=dry_run
AGENT_MUTATIONS_ENABLED=false
AGENT_MODEL_EXECUTION_ENABLED=false
AGENT_WORKFLOW_PROVIDER=in_memory

# Required only when connecting the runtime to Supabase/Postgres.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required only when AGENT_MODEL_EXECUTION_ENABLED=true.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=
OPENAI_AGENT_MAX_TURNS=4

# Optional observability identifiers.
AGENT_RUNTIME_VERSION=phase-b-v1
AGENT_TRACE_NAMESPACE=nested-objects-intelligence-os

# Reserved extension points. Phase B does not register production Workflow or Queue adapters.
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_TOKEN=
