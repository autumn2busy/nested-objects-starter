        {
            "parameters": {
                "jsCode": "// Tier limits\nconst limits = {\n  free: 0,\n  starter: 5,\n  pro: 10,\n  elite: 20,\n  agency: 999999\n};\n\n// Get usage data from HTTP Request response\nconst usageResponse = $input.first().json;\n\n// Handle both fullResponse format and direct format\nconst callCount = parseInt(usageResponse.call_count || usageResponse.body?.call_count) || 0;\n\n// Get user data from earlier node\nconst userData = $('Validate & Decode JWT1').first().json;\nconst tier = userData.tier;\n\nconst limit = limits[tier] || 0;\nconst allowed = callCount < limit;\n\nreturn [{\n  json: {\n    user_id: userData.user_id,\n    outseta_uid: userData.outseta_uid,\n    tier: tier,\n    prompt: userData.prompt,\n    call_count: callCount,\n    limit: limit,\n    remaining: Math.max(0, limit - callCount),\n    allowed: allowed\n  }\n}];"
            },
