        {
            "parameters": {
                "jsCode": "// Extract and decode JWT\nconst body = $input.item.json.body;\n\nif (!body.jwt || !body.prompt) {\n  return [{ json: { error: 'Missing jwt or prompt', valid: false } }];\n}\n\ntry {\n  // Decode Outseta JWT\n  const jwt = body.jwt;\n  const parts = jwt.split('.');\n  \n  // Base64 decode fix\n  const base64Url = parts[1];\n  const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');\n  const payload = JSON.parse(Buffer.from(base64, 'base64').toString());\n  \n  // Extract User & Plan Info (Outseta Custom Claims)\n  const userId = payload.sub; \n  const outsetaUid = payload.sub;\n  const planUid = payload['outseta:planUid'];\n\n  // PLAN MAPPING\n  const planMap = {\n     'zWZD0rQp': 'starter',\n     'rQVqlLm6': 'pro',\n     'NmdnNO90': 'elite',\n     'rmk5Xk9g': 'agency',\n     'L9nbKV9Z': 'free'\n  };\n\n  // Determine Tier\n  let tier = 'free';\n  if (planUid && planMap[planUid]) {\n    tier = planMap[planUid];\n  } else if (payload.Account?.SubscriptionPlan?.Uid) {\n     const legacyUid = payload.Account.SubscriptionPlan.Uid.toLowerCase();\n     if (legacyUid.includes('agency')) tier = 'agency';\n     else if (legacyUid.includes('elite')) tier = 'elite';\n     else if (legacyUid.includes('pro')) tier = 'pro';\n     else if (legacyUid.includes('starter')) tier = 'starter';\n  }\n  \n  return [{ \n    json: {\n      valid: true,\n      user_id: userId,\n      outseta_uid: outsetaUid,\n      tier: tier,\n      prompt: body.prompt\n    }\n  }];\n} catch (error) {\n  return [{ json: { error: 'Invalid JWT: ' + error.message, valid: false } }];\n}\n"
            },
            "id": "7eb5f862-c203-412a-89a0-78fa2bd98a6c",
