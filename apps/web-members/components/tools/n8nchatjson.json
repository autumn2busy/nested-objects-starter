                "responseBody": "=={{ { \n  error: $json.tier === 'free' \n    ? 'AI features require a paid plan. Upgrade to Starter or higher to access AI tools.' \n    : 'Quota exceeded. You have used all ' + $json.limit + ' AI calls this month. Upgrade to Pro for more.',\n  tier: $json.tier, \n  limit: $json.limit, \n  call_count: $json.call_count,\n  upgrade_url: 'https://members.nestedobjects.com/upgrade'\n} }}",
                "options": {}
