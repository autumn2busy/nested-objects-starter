        {
            "parameters": {
                "jsCode": "// Extract response from Groq\nconst groqResponse = $input.first().json;\n\n// Get user/quota data from the \"Has Quota?\" node (carries forward all the data)\nconst quotaData = $('Has Quota?1').first().json;\n\nreturn [{\n  json: {\n    // Data for logging\n    user_id: quotaData.user_id,\n    outseta_uid: quotaData.outseta_uid,\n    tier: quotaData.tier,\n    prompt_tokens: groqResponse.usage?.prompt_tokens || 0,\n    completion_tokens: groqResponse.usage?.completion_tokens || 0,\n    total_tokens: groqResponse.usage?.total_tokens || 0,\n    model: groqResponse.model || 'llama3-70b-8192',\n    // Response to return\n    response: groqResponse.choices[0]?.message?.content || 'No response',\n    remaining: quotaData.remaining - 1\n  }\n}];\n"
            },
